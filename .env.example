# .env.example
# Plantilla de variables de entorno del proyecto. Copia este archivo a `.env`
# (`cp .env.example .env`) y ajusta los valores. `.env` NO se versiona.
# Docker Compose lee `.env` y se lo pasa a los servicios `db` y `api`.

# --- Base de datos (servicio `db`, imagen oficial de PostgreSQL) ---
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=tu_db

# Puerto del host donde se expone Postgres (útil para inspeccionar con psql/DBeaver).
DB_HOST_PORT=5432

# --- API ---
# URL de conexión de SQLAlchemy (driver psycopg 3). Dentro de la red de Compose
# el host es el nombre del servicio: `db`. Si corres la API fuera de Docker,
# usa `localhost` y el puerto DB_HOST_PORT.
DATABASE_URL=postgresql+psycopg://tu_usuario:cambia_esta_clave@db:5432/tu_db